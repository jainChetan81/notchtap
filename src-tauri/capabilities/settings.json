{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "settings",
	"description": "Settings window only: the fifteen settings commands plus event listen/unlisten. The overlay's default.json must never gain any of these.",
	"windows": ["settings"],
	"permissions": [
		"allow-clear-history",
		"allow-clear-queue",
		"allow-get-about-info",
		"allow-get-agent-health",
		"allow-get-config",
		"allow-get-default-config",
		"allow-get-history",
		"allow-get-queue",
		"allow-get-recent-log-lines",
		"allow-save-config-and-relaunch",
		"allow-search-news-now",
		"allow-send-agent-test-event",
		"allow-send-test-notification",
		"allow-set-appearance",
		"allow-skip-current",
		"core:event:allow-listen",
		"core:event:allow-unlisten"
	]
}
